{
    "name": "redacted",
    "version": "1.0.5",
    "description": "Replaces selected text with block or other custom characters to redact it in place.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "redacted"
    ],
    "author": "Julie Sandburg",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^16.11.6",
        "esbuild": "0.17.3",
        "obsidian": "latest",
        "tslib": "2.4.0",
        "typescript": "4.7.4"
    }
}
