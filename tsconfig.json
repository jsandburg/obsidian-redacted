{
    "compilerOptions": {
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ES2018",
        "allowJs": true,
        "moduleResolution": "bundler",
        "importHelpers": true,
        "isolatedModules": true,
        "strict": true,
        "lib": ["DOM", "ES2018", "ES2022.Intl"]
    },
    "include": ["**/*.ts"]
}
